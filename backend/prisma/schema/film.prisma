model FilmWatchHistory {
  id               String   @id @default(uuid())
  userId           String
  externalFilmId   String
  filmSlug         String?
  filmTitle        String
  posterUrl        String?
  thumbUrl         String?
  episodeSlug      String?
  episodeTitle     String?
  playbackPosition Int      @default(0)
  duration         Int      @default(0)
  isCompleted      Boolean  @default(false)
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, externalFilmId])
  @@index([userId])
  @@map("film_watch_history")
}

model FilmFavorite {
  id             String   @id @default(uuid())
  userId         String
  externalFilmId String
  filmSlug       String?
  filmTitle      String
  posterUrl      String?
  thumbUrl       String?
  releaseYear    Int?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, externalFilmId])
  @@index([userId])
  @@map("film_favorites")
}
